---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Container from '../../components/primitives/Container.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ScrollProgress from '../../components/ScrollProgress.astro';
import Button from '../../components/primitives/Button.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  abstract: data.summary,
  author: { '@type': 'Person', name: 'Madasamy Muthukumar R' },
  keywords: data.tags.join(', '),
  dateCreated: data.date.toISOString().slice(0, 10),
};
---

<Base
  title={`${data.title} — Madasamy Muthukumar`}
  description={data.summary}
  type="article"
  image={`/og/${project.id}.png`}
  schema={schema}
>
  <ScrollProgress />
  <Nav />

  <main id="content">
    <article style="padding-block: clamp(3rem, 8vw, 5rem) var(--spacing-section);">
      <Container>
        <a
          href="/#work"
          class="inline-flex min-h-11 items-center font-mono text-step-s text-muted transition-colors hover:text-accent-text"
        >
          ← Back to work
        </a>

        <header class="mt-8 border-b border-border pb-10">
          <p class="font-mono text-step-s tracking-[0.14em] text-muted uppercase">
            {data.period}
          </p>
          <h1 class="mt-4 text-step-4 font-semibold">{data.title}</h1>
          <p class="mt-5 max-w-[46ch] text-step-1 text-muted">{data.summary}</p>
          <p class="mt-4 font-mono text-step-s text-muted">{data.role}</p>

          {(data.repo || data.live) && (
            <div class="mt-7 flex flex-wrap gap-3">
              {data.live && (
                <Button href={data.live} external>
                  Visit site
                </Button>
              )}
              {data.repo && (
                <Button href={data.repo} variant="ghost" external>
                  Source
                </Button>
              )}
            </div>
          )}

          <ul class="mt-8 flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <li class="rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-step-s">
                {tag}
              </li>
            ))}
          </ul>
        </header>

        {data.stats.length > 0 && (
          <dl class="grid gap-6 border-b border-border py-10 sm:grid-cols-3">
            {data.stats.map((stat) => (
              <div>
                <dt class="font-mono text-step-s tracking-[0.14em] text-muted uppercase">
                  {stat.label}
                </dt>
                <dd class="mt-2 text-step-1">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {data.cover && (
          <Image
            src={data.cover}
            alt={data.coverAlt ?? ''}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 68rem, 92vw"
            class="mt-10 w-full rounded-xl border border-border"
          />
        )}

        <div class="prose-case mt-12">
          <Content />
        </div>
      </Container>
    </article>
  </main>

  <Footer />
</Base>

---
/**
 * Internal build probe, not part of the portfolio. Excluded from the sitemap
 * and marked noindex. It exists so every build exercises the React island path
 * and the content-collection query without loading either onto a real page.
 * Safe to delete once Phase 2 components cover the same ground.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReactProbe from '../components/ReactProbe.tsx';

const projects = await getCollection('projects', ({ data }) => !data.draft);
---

<Base title="Stack check" description="Internal build probe." noindex>
  <div class="mx-auto flex max-w-2xl flex-col gap-6 px-4 py-16">
    <h1 class="text-step-3 font-semibold tracking-tight">Stack check</h1>

    <section class="flex flex-col gap-2">
      <h2 class="text-step-1 font-medium">React island</h2>
      <div>
        <ReactProbe client:visible />
      </div>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-step-1 font-medium">
        Content collection ({projects.length})
      </h2>
      <ul class="flex flex-col gap-1 text-muted">
        {projects.map((p) => (
          <li>
            {p.data.title} — {p.data.cover.width}×{p.data.cover.height}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

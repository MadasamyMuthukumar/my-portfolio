---
import Container from './Container.astro';

interface Props {
  id: string;
  /** Two-digit index, e.g. "01". */
  index?: string;
  label?: string;
  title?: string;
  /**
   * Background tone. Sections alternate paper / warm down the page so the
   * rhythm comes from the surface itself rather than from dividers alone.
   */
  tone?: 'paper' | 'warm';
  /**
   * Draw the gradient rule at the top edge. Off for the section that follows
   * the hero, where the wave already does the dividing.
   */
  rule?: boolean;
  class?: string;
}

const {
  id,
  index,
  label,
  title,
  tone = 'paper',
  rule = true,
  class: className = '',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20',
    rule && 'section-rule',
    tone === 'warm' && 'bg-surface-warm',
    className,
  ]}
  style="padding-block: var(--spacing-section);"
>
  <Container>
    {(index || label || title) && (
      <header class="reveal mb-10 sm:mb-14">
        {(index || label) && (
          <p class="mb-4 font-mono text-step-s tracking-[0.18em] text-muted uppercase">
            {index && <span class="text-accent-text">{index}</span>}
            {index && label && <span class="mx-2 opacity-40">—</span>}
            {label}
          </p>
        )}
        {title && <h2 class="text-step-3 font-semibold">{title}</h2>}
      </header>
    )}
    <slot />
  </Container>
</section>

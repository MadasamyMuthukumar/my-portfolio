---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

{/* Never accent-filled — chips are texture, not calls to action. */}
<li
  class:list={[
    'rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-step-s text-ink/85',
    className,
  ]}
>
  <slot />
</li>

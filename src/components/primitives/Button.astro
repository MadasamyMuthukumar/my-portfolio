---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  download = false,
  class: className = '',
} = Astro.props;

const base =
  // min-h-11 == 44px: the iOS touch-target floor, enforced at every size.
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 text-step-0 font-medium transition-[transform,background-color,border-color] duration-150 ease-out active:translate-y-px';

const variants = {
  primary:
    'bg-accent text-accent-contrast hover:brightness-95 motion-safe:hover:-translate-y-0.5',
  ghost:
    'border border-border-strong text-ink hover:border-ink motion-safe:hover:-translate-y-0.5',
};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  {...(download ? { download: '' } : {})}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>

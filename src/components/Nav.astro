---
import Container from './primitives/Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile, navLinks } from '../data/resume';
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-paper/85 backdrop-blur-md">
  <Container>
    <nav
      class="flex min-h-16 items-center justify-between gap-4"
      aria-label="Primary"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-mono text-step-s tracking-[0.14em] uppercase transition-colors hover:text-accent-text"
      >
        {profile.shortName}
      </a>

      {/* Inline links from md up. */}
      <ul class="hidden items-center gap-7 md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-step-s text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <ThemeToggle />

        {/*
          Below md, a native <details> disclosure replaces the link row.
          Semantic, keyboard-accessible, and needs no JavaScript framework.
        */}
        <details id="nav-menu" class="relative md:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md border border-border text-muted transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
            aria-label="Open navigation menu"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 5h14M2 9h14M2 13h14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
            </svg>
          </summary>

          <ul class="absolute right-0 z-50 mt-2 w-44 rounded-xl border border-border bg-paper p-2 shadow-[0_12px_40px_-12px_rgb(0_0_0/0.25)]">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex min-h-11 items-center rounded-lg px-3 text-step-0 text-muted transition-colors hover:bg-surface hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </nav>
  </Container>
</header>

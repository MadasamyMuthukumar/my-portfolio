---
import Container from './primitives/Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile, navLinks } from '../data/resume';
---

{/*
  This bar's height — min-h-16 (4rem) plus its 1px bottom border — is mirrored
  by --nav-h in global.css, which the hero subtracts so it fills exactly the
  space below here. Change one and you must change the other.
*/}
<header class="sticky top-0 z-40 border-b border-border/70 bg-paper/85 backdrop-blur-md">
  <Container>
    <nav
      class="flex min-h-16 items-center justify-between gap-4"
      aria-label="Primary"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-mono text-step-s tracking-[0.14em] uppercase transition-colors hover:text-accent-text"
      >
        {profile.navName}
      </a>

      {/* Inline links from md up. */}
      <ul class="hidden items-center gap-7 md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-step-s text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <ThemeToggle />

        {/*
          Below md, a native <details> drives a full-width drawer. Kept as
          <details> rather than a div plus JS because it is already
          keyboard-operable and Escape-closes for free.
        */}
        <details id="nav-menu" class="nav-drawer md:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-border text-muted transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
            aria-label="Open navigation menu"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
            >
              <path
                class="nav-burger-top"
                d="M2 5h14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
              <path
                class="nav-burger-mid"
                d="M2 9h14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
              <path
                class="nav-burger-bottom"
                d="M2 13h14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              ></path>
            </svg>
          </summary>

          {/*
            Anchored to the header, not this button, so the panel spans the
            full width and reads as a drawer coming down from the bar.
          */}
          {/* Solid, not translucent: at 95% the hero's monogram read through the
                panel and competed with the links. */}
          <div class="absolute inset-x-0 top-full z-50 border-b border-border bg-paper shadow-[0_18px_40px_-24px_rgb(0_0_0/0.45)]">
            <ul class="px-[var(--spacing-gutter)] py-3">
              {navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="nav-drawer-link flex min-h-12 items-center rounded-lg px-3 text-step-1 text-muted"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </nav>
  </Container>
</header>

<script is:inline>
  (() => {
    const drawer = document.getElementById('nav-menu');
    if (!drawer) return;

    // The links are same-page anchors, so without this the drawer would stay
    // open on top of the content the user just jumped to.
    drawer.addEventListener('click', (e) => {
      if (e.target.closest('a')) drawer.open = false;
    });

    // Tapping anywhere else dismisses it, matching what a drawer implies.
    document.addEventListener('click', (e) => {
      if (drawer.open && !drawer.contains(e.target)) drawer.open = false;
    });
  })();
</script>

---
/**
 * Theme toggle. Deliberately NOT a React island — it is one button, and
 * mounting React for it would ship ~210 KB to every page that uses it.
 * `is:inline` keeps this out of the bundle graph entirely: no extra request.
 */
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle colour theme"
  class="rounded-md border border-border px-3 py-1.5 text-step-s text-muted transition-colors hover:text-fg"
>
  <span data-theme-label>Theme</span>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const label = btn.querySelector('[data-theme-label]');

    const current = () =>
      document.documentElement.dataset.theme ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light');

    const sync = () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      label.textContent = next === 'dark' ? 'Dark mode' : 'Light mode';
      btn.setAttribute('aria-label', `Switch to ${next} theme`);
    };

    sync();

    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked — toggle still works for this session */
      }
      sync();
    });
  })();
</script>

---
import { getCollection } from 'astro:content';
import Section from '../primitives/Section.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectRow from '../ProjectRow.astro';

const all = await getCollection('projects', ({ data }) => !data.draft);

// One comparator, not two chained .sort() calls — the second would silently
// discard the first key and bury the featured flagship.
const primary = all
  .filter((p) => p.data.tier === 'primary')
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.valueOf() - a.data.date.valueOf(),
  );

// Anything with a live demo leads: a link the visitor can actually click is
// worth more than a slightly newer repo.
const secondary = all
  .filter((p) => p.data.tier === 'secondary')
  .sort(
    (a, b) =>
      Number(Boolean(b.data.live)) - Number(Boolean(a.data.live)) ||
      b.data.date.valueOf() - a.data.date.valueOf(),
  );
---

<Section id="work" index="03" label="Work" title="What I've built" tone="warm">
  {/*
    Below md this is a scroll-snap track: one card per view with the next
    peeking, and swipe working with no JavaScript at all. From md up the same
    markup becomes the intrinsic grid again (see .card-track in global.css).
    The track owns its overflow, so the document never scrolls sideways.
  */}
  <ul
    id="work-track"
    class="card-track"
    role="region"
    aria-label="Selected projects"
    tabindex="0"
  >
    {primary.map((project) => (
      <li class="reveal">
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>

  {/* Arrows and dots are enhancement only — swiping already works without them. */}
  {primary.length > 1 && (
    <div
      id="work-controls"
      class="mt-5 flex items-center justify-between md:hidden"
    >
      <ul class="flex items-center gap-2" aria-hidden="true">
        {primary.map((_, i) => (
          <li
            class="card-dot h-1.5 w-1.5 rounded-full"
            data-dot
            aria-current={i === 0 ? 'true' : 'false'}
          />
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <button
          type="button"
          data-prev
          aria-controls="work-track"
          aria-label="Previous project"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent-text disabled:opacity-40"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 3 5 8l5 5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <button
          type="button"
          data-next
          aria-controls="work-track"
          aria-label="Next project"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent-text disabled:opacity-40"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 3l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  )}

  {secondary.length > 0 && (
    <div class="mt-16 sm:mt-20">
      {/*
          A sub-heading inside Work, not a section of its own: a new <Section>
          would renumber Skills/Education/Contact and add a nav anchor for what
          is really part of the same idea.
        */}
      <h3 class="reveal font-mono text-step-s tracking-[0.18em] text-muted uppercase">
        Also built
      </h3>

      <ul class="mt-6">
        {secondary.map((project) => (
          <li class="reveal">
            <ProjectRow project={project} />
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<script is:inline>
  (() => {
    const track = document.getElementById('work-track');
    const controls = document.getElementById('work-controls');
    if (!track || !controls) return;

    const cards = [...track.children];
    const dots = [...controls.querySelectorAll('[data-dot]')];
    const prev = controls.querySelector('[data-prev]');
    const next = controls.querySelector('[data-next]');

    /** Index of the card nearest the track's horizontal centre. */
    const current = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((card, i) => {
        const gap = Math.abs(card.offsetLeft + card.offsetWidth / 2 - mid);
        if (gap < bestGap) {
          bestGap = gap;
          best = i;
        }
      });
      return best;
    };

    const go = (i) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (!card) return;
      track.scrollTo({
        left: card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      });
    };

    const sync = () => {
      const i = current();
      dots.forEach((dot, n) =>
        dot.setAttribute('aria-current', String(n === i)),
      );
      prev.disabled = i === 0;
      next.disabled = i === cards.length - 1;
    };

    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    track.addEventListener('scroll', () => {
      // Coalesce scroll events into one update per frame.
      if (track.dataset.raf) return;
      track.dataset.raf = '1';
      requestAnimationFrame(() => {
        delete track.dataset.raf;
        sync();
      });
    });

    sync();
  })();
</script>

---
import { getCollection } from 'astro:content';
import Section from '../primitives/Section.astro';
import ProjectCard from '../ProjectCard.astro';

// One comparator: featured first, then newest. Chaining two .sort() calls
// would let the second silently discard the first key.
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Section id="work" index="03" label="Work" title="Selected projects">
  {/*
    Intrinsic grid: reflows on its own without breakpoints. The min(100%, …)
    is what prevents overflow at 320px.
  */}
  <ul
    class="grid gap-6"
    style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));"
  >
    {projects.map((project) => (
      <li class="reveal">
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
</Section>

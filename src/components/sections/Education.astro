---
import Section from '../primitives/Section.astro';
import { education } from '../../data/resume';
---

<Section id="education" index="05" label="Education">
  <div class="reveal flex flex-col justify-between gap-3 border-t border-border pt-8 sm:flex-row sm:items-baseline sm:gap-8">
    <div>
      <h3 class="text-step-2 font-semibold">{education.degree}</h3>
      <p class="mt-1 text-step-0 text-muted">
        {education.institution}, {education.location}
      </p>
    </div>
    <p class="shrink-0 font-mono text-step-s text-muted sm:text-right">
      {education.start} — {education.end}
      <br class="hidden sm:block" />
      <span class="sm:hidden"> · </span>
      {education.result}
    </p>
  </div>
</Section>

---
import Section from '../primitives/Section.astro';
import { experience } from '../../data/resume';
---

<Section
  id="experience"
  index="02"
  label="Experience"
  title="Where I've worked"
>
  <ol class="space-y-12 sm:space-y-16">
    {experience.map((role) => (
      <li class="reveal grid gap-5 border-t border-border pt-8 lg:grid-cols-[18rem_1fr] lg:gap-12">
        <div class="sticky-label self-start">
          <h3 class="text-step-2 font-semibold">{role.company}</h3>
          <p class="mt-1 text-step-0 text-muted">{role.title}</p>
          <p class="mt-3 font-mono text-step-s text-muted">
            {role.start} — {role.end}
            {role.current && (
              <span class="ml-2 inline-flex items-center gap-1.5 text-accent-text">
                <span
                  class="inline-block h-1.5 w-1.5 rounded-full bg-accent"
                  aria-hidden="true"
                />
                Current
              </span>
            )}
          </p>
          <p class="mt-1 font-mono text-step-s text-muted">{role.location}</p>
        </div>

        <ul class="space-y-4">
          {role.highlights.map((point) => (
            <li class="relative pl-6 text-step-0 text-muted">
              <span
                class="absolute top-[0.7em] left-0 h-1.5 w-1.5 rounded-full bg-border-strong"
                aria-hidden="true"
              />
              <span class="max-w-[var(--measure)]">{point}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>

---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import PhotoCard from '../PhotoCard.astro';
import { profile } from '../../data/resume';
---

<section class="hero-shell" aria-labelledby="hero-heading">
  <Container>
    {/*
      Stacks on phones, splits 58/42 from md (768px) up. Tablets get the same
      4:5 card as desktop — as a stack the content ran ~700px tall with a small
      floating circle; side by side it is ~410px and properly centred.
    */}
    <div class="grid items-center gap-[var(--hero-column-gap)] md:grid-cols-[58fr_42fr] md:gap-[clamp(2rem,4vw,4rem)]">
      <div class="order-2 md:order-1">
        <p
          class="hero-in mb-[var(--hero-eyebrow-gap)] font-mono text-step-s tracking-[0.18em] text-muted uppercase"
          style="animation-delay: 60ms"
        >
          {profile.role}
        </p>

        <h1
          id="hero-heading"
          class="hero-in text-step-5 font-semibold"
          style="animation-delay: 120ms"
        >
          Hi, I'm{' '}
          <span class="font-display font-normal italic tracking-normal">
            {profile.nickname}
          </span>
          .
        </h1>

        <p
          class="hero-in mt-[var(--hero-lede-gap)] max-w-[38ch] text-step-1 text-muted"
          style="animation-delay: 200ms"
        >
          {profile.tagline}
        </p>

        <div
          class="hero-in mt-[var(--hero-cta-gap)] flex flex-wrap items-center gap-3"
          style="animation-delay: 280ms"
        >
          <Button href="#work">View my work</Button>
          <Button href="/resume" variant="ghost">
            Résumé
          </Button>
        </div>

        <ul
          class="hero-in mt-[var(--hero-links-gap)] flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-step-s text-muted"
          style="animation-delay: 340ms"
        >
          <li>
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-border underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-border underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="underline decoration-border underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent"
            >
              Email
            </a>
          </li>
        </ul>
      </div>

      <div class="hero-in order-1 md:order-2" style="animation-delay: 160ms">
        <PhotoCard alt={`Portrait of ${profile.name}`} />
      </div>
    </div>
  </Container>
</section>

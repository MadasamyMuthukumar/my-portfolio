---
import type { CollectionEntry } from 'astro:content';

/**
 * Compact row for secondary-tier projects.
 *
 * Deliberately lighter than ProjectCard: no cover image, and tags render as
 * plain separated mono text rather than Chip components. That weight
 * difference IS the hierarchy — it is what stops a weekend project reading as
 * the equal of the flagship case study.
 *
 * The row is NOT a link container. It carries two links (Live / Source), and
 * an anchor cannot legally contain another anchor.
 */
interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<div class="border-t border-border py-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
    <h4 class="text-step-1 font-semibold">{data.title}</h4>

    <ul class="flex shrink-0 items-center gap-4 font-mono text-step-s">
      {data.live && (
        <li>
          <a
            href={data.live}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-1 text-accent-text underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent"
          >
            Live
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      )}
      {data.repo && (
        <li>
          <a
            href={data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-1 text-muted underline decoration-border underline-offset-4 transition-colors hover:text-ink hover:decoration-border-strong"
          >
            Source
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      )}
    </ul>
  </div>

  <p class="mt-1 max-w-[var(--measure)] text-step-0 text-muted">
    {data.summary}
  </p>

  {/* Separated mono text, not chips — keeps this tier visually quieter. */}
  <p class="mt-3 font-mono text-step-s text-muted/80">
    {data.tags.join(' · ')}
  </p>
</div>

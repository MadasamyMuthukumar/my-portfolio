---
import { Image } from 'astro:assets';

/**
 * Hero portrait. Falls back to a monogram so the build is never blocked on a
 * photo arriving. Drop a 4:5 image at src/assets/portrait.jpg and import it
 * here to swap in the real thing.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  initials?: string;
}

const { src, alt = '', initials = 'MM' } = Astro.props;
---

<div class="relative mx-auto w-[clamp(7.5rem,42vw,13.75rem)] md:w-[clamp(11rem,30vw,15rem)] lg:mx-0 lg:w-full lg:max-w-[21rem]">
  {/* The one loud use of accent on the page. Desktop only — at phone sizes the
      photo is a circle and the offset block would read as a smudge. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 hidden translate-x-3 translate-y-3 rounded-2xl bg-accent lg:block"
  ></div>

  <div class="relative aspect-square overflow-hidden rounded-full border border-border bg-surface lg:aspect-[4/5] lg:rounded-2xl">
    {src ? (
      <Image
        src={src}
        alt={alt}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 1024px) 21rem, (min-width: 768px) 15rem, 42vw"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-accent/10">
        <span
          class="font-display text-[clamp(2.5rem,12vw,5rem)] leading-none text-accent-text"
          aria-hidden="true"
        >
          {initials}
        </span>
      </div>
    )}
  </div>
</div>

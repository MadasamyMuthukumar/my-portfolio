---
import { Image } from 'astro:assets';

/**
 * Hero portrait. Falls back to a monogram so the build is never blocked on a
 * photo arriving. Drop a 4:5 image at src/assets/portrait.jpg and import it
 * here to swap in the real thing.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  initials?: string;
}

const { src, alt = '', initials = 'MM' } = Astro.props;
---

{/*
  Sized against BOTH axes, so it takes whatever space each viewport actually
  has instead of a single width-driven guess.

  Circle (phones): the width term is generous — 46vw fills a tall phone — and
  the 22vh cap is what reins it in on short ones. On a 360x640 the cap binds
  and keeps it at ~141px so the CTAs stay above the fold; on a 440x956 the
  width term wins and it reaches ~202px.

  Card (md+): capped by 52vh rather than the text column's height, because in
  a side-by-side grid with items-center the photo only pushes the hero taller
  once it exceeds the text column — and there is slack past that point. Paired
  with w-full it fills the 42fr column whenever the column is the tighter of
  the two, which is what happens on tablets.
*/}
<div class="relative mx-auto w-[min(clamp(7.5rem,46vw,18rem),22vh)] md:mx-0 md:w-full md:max-w-[min(26rem,52vh)]">
  {/* The one loud use of accent on the page. Card layouts only — at phone
      sizes the photo is a circle and the offset block would read as a smudge. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 hidden translate-x-3 translate-y-3 rounded-2xl bg-accent md:block"
  ></div>

  <div class="relative aspect-square overflow-hidden rounded-full border border-border bg-surface md:aspect-[4/5] md:rounded-2xl">
    {src ? (
      <Image
        src={src}
        alt={alt}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 768px) 26rem, 46vw"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-accent/10">
        <span
          class="font-display text-[clamp(2.5rem,12vw,5rem)] leading-none text-accent-text"
          aria-hidden="true"
        >
          {initials}
        </span>
      </div>
    )}
  </div>
</div>

---
import { Image } from 'astro:assets';

/**
 * Hero portrait. Falls back to a monogram so the build is never blocked on a
 * photo arriving. Drop a 4:5 image at src/assets/portrait.jpg and import it
 * here to swap in the real thing.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  initials?: string;
}

const { src, alt = '', initials = 'MM' } = Astro.props;
---

{/*
  Sized against BOTH axes. The width clamp alone knows nothing about vertical
  room, so on a short screen the circle stayed large and pushed the CTAs below
  the fold. min(…, 30vh) makes one rule do both jobs: it shrinks the photo when
  height is scarce and lets it grow into spare vertical space on tablets.

  The card's 40vh cap is looser than the circle's because in a side-by-side
  grid the photo only adds height once it exceeds the text column — capping it
  tighter just made it look undersized without buying any vertical room.
*/}
<div class="relative mx-auto w-[min(clamp(7.5rem,38vw,18rem),30vh)] md:mx-0 md:w-full md:max-w-[min(21rem,40vh)]">
  {/* The one loud use of accent on the page. Card layouts only — at phone
      sizes the photo is a circle and the offset block would read as a smudge. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 hidden translate-x-3 translate-y-3 rounded-2xl bg-accent md:block"
  ></div>

  <div class="relative aspect-square overflow-hidden rounded-full border border-border bg-surface md:aspect-[4/5] md:rounded-2xl">
    {src ? (
      <Image
        src={src}
        alt={alt}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 768px) 21rem, 38vw"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-accent/10">
        <span
          class="font-display text-[clamp(2.5rem,12vw,5rem)] leading-none text-accent-text"
          aria-hidden="true"
        >
          {initials}
        </span>
      </div>
    )}
  </div>
</div>

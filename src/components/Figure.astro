---
import { Image } from 'astro:assets';

/**
 * A figure inside a case study. Imported directly by the MDX so screenshots
 * sit in the section they illustrate rather than all at the top.
 *
 * Lazy by design: these are well below the fold. The hero photo is the LCP
 * element and keeps eager + fetchpriority=high.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="case-figure">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 68rem, 92vw"
    loading="lazy"
    decoding="async"
    class="w-full rounded-xl border border-border"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
